<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GameDesk</AssemblyName>
    <Version>0.1.0</Version>
    <Product>GameDesk for Windows</Product>
    <Description>Live network monitoring and match review for eFootball.</Description>
    <RepositoryUrl>https://github.com/shariski/gamedesk-windows</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <EmbeddedResource Include="Data/providers.tsv.gz" LogicalName="GameDesk.Providers" />
  </ItemGroup>
</Project>
